# ==============================================================================
# ReconFlow AI — Environment Configuration Template (100% Free & Open Source)
# ==============================================================================

# --- Search & Intelligence Infrastructure ---
# Open-source search requires zero commercial API subscriptions (DuckDuckGo, Google, BeautifulSoup)
# Built-in Proxy Rotation Pool (comma-separated or configured in backend/proxies.txt)
ENABLE_PROXY_ROTATION=true
PROXY_LIST=

# Google Gemini API Key for dynamic AI CISO executive summaries & findings triage (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# --- Backend Server Configuration ---
HOST=0.0.0.0
PORT=8001

# --- Frontend Web Application ---
NEXT_PUBLIC_API_URL=http://localhost:8001
